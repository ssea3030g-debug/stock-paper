# .env.example 을 .env 로 복사해서 채우세요. .env 는 절대 공개 저장소에 올리지 마세요.
# 비워 둔 키는 해당 출처를 건너뛰고 대체 출처(Yahoo) 또는 "데이터 없음"으로 표시합니다.

# 한국은행 ECOS — 원/달러 환율, 국고채 3년  (https://ecos.bok.or.kr/api)
ECOS_API_KEY=

# FRED — 유가, 미 국채 10년, 미국 지표 발표 일정  (https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=

# KRX 정보데이터시스템 Open API — 코스피·코스닥 공식 지수  (https://openapi.krx.co.kr)
KRX_API_KEY=

# 한국투자증권 KIS Developers — 투자자별 순매수 (선택)
KIS_APP_KEY=
KIS_APP_SECRET=

# Claude API — summary.provider 가 api/auto 일 때 요약 (선택, 유료)
ANTHROPIC_API_KEY=
